{
  "schema_version": 1,
  "id": "mutillidae",
  "display_name": "OWASP Mutillidae II",
  "description": "Multi-service web security training environment.",
  "categories": [
    "web",
    "php",
    "owasp"
  ],
  "runtime_backend": "docker-engine",
  "upstream": {
    "repository": "https://github.com/webpwnized/mutillidae",
    "homepage": "https://owasp.org/www-project-mutillidae-ii/"
  },
  "version": {
    "release": "main",
    "tag": "main",
    "commit": ""
  },
  "license": {
    "spdx": "GPL-3.0-only",
    "evidence_url": "https://github.com/webpwnized/mutillidae/blob/main/LICENSE",
    "redistribution": "Upstream images would be pulled; modifications and redistribution must satisfy GPL-3.0."
  },
  "trust": {
    "level": "quarantined",
    "evidence": [
      "https://github.com/webpwnized/mutillidae/blob/main/.github/workflows/build-scan-push-to-dockerhub.yml"
    ],
    "limitations": [
      "Provenance, containment, licensing, architecture, or functionality review is incomplete."
    ],
    "status_reason": "Five official components still require a jointly reviewed digest lock and database, LDAP, and vulnerability-catalogue smoke verification."
  },
  "images": [
    {
      "name": "docker.io/webpwnized/mutillidae",
      "digest": "",
      "architectures": [
        "linux/amd64"
      ],
      "role": "application"
    }
  ],
  "services": [
    {
      "name": "web",
      "image_role": "application",
      "internal_port": 80,
      "protocol": "http",
      "health_path": "/",
      "identity_regex": "Mutillidae"
    }
  ],
  "friendly_hostname": "mutillidae.test",
  "health_check": {
    "type": "http-identity-and-functionality",
    "checks": [
      "Database setup complete",
      "LDAP populated",
      "Landing page and vulnerability catalogue usable"
    ],
    "timeout_seconds": 120
  },
  "initialization": {
    "automatic": false,
    "steps": [
      "Run set-up-database.php",
      "Populate LDAP from upstream LDIF"
    ]
  },
  "reset": {
    "strategy": "Recreate all five owned services and MySQL/LDAP state",
    "effects": [
      "mysql",
      "ldap-database",
      "ldap-config"
    ]
  },
  "default_credentials": [
    "LDAP cn=admin,dc=mutillidae,dc=localhost / mutillidae"
  ],
  "resources": {
    "memory_mb": 1536,
    "cpus": 2,
    "pids": 768,
    "read_only_root": false
  },
  "persistence": {
    "required": true,
    "volumes": [
      "mysql",
      "ldap-database",
      "ldap-config"
    ]
  },
  "outbound_network": {
    "required": false,
    "reason": "Core web and directory exercises can use local services.",
    "challenge_dependencies": [
      "Network-oriented exercises may require contained fixtures"
    ]
  },
  "dangerous_capabilities": [],
  "expected_functionality": [
    "Vulnerability catalogue",
    "Hints, challenges, and secure/insecure modes",
    "REST and SOAP exercises"
  ],
  "known_limitations": [
    "Official configuration expects mutillidae.localhost",
    "No verified multi-architecture stack"
  ],
  "last_verified": "2026-09-06",
  "adapter_status": "quarantined",
  "verification": {
    "status": "blocked",
