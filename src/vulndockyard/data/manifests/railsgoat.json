  },
  "version": {
    "release": "main",
    "tag": "main",
    "commit": "0222f7da3406ba3ab637bc6d24ae9366b5f0a680"
  },
  "license": {
    "spdx": "MIT",
    "evidence_url": "https://github.com/OWASP/railsgoat/blob/0222f7da3406ba3ab637bc6d24ae9366b5f0a680/LICENSE.md",
    "redistribution": "A future project build is legally possible with MIT notice, but none is authorized until its build review passes."
  },
  "trust": {
    "level": "quarantined",
    "evidence": [
      "https://github.com/OWASP/railsgoat/blob/0222f7da3406ba3ab637bc6d24ae9366b5f0a680/docker-compose.yml"
    ],
    "limitations": [
      "Provenance, containment, licensing, architecture, or functionality review is incomplete."
    ],
    "status_reason": "No upstream-published image exists; official Compose builds and broadly mounts source, and full lessons need unbundled MySQL and MailCatcher."
  },
  "images": [],
  "services": [
    {
      "name": "web",
      "image_role": "application",
      "internal_port": 3000,
      "protocol": "http",
      "health_path": "/",
      "identity_marker": "RailsGoat"
    },
    {
      "name": "database",
      "image_role": "database",
      "internal_port": 3306,
      "protocol": "tcp",
      "health_path": "/",
      "identity_marker": "MySQL"
    },
    {
      "name": "mail-smtp",
      "image_role": "mail",
      "internal_port": 1025,
      "protocol": "tcp",
      "health_path": "/",
      "identity_marker": "SMTP"
    },
    {
      "name": "mail-web",
      "image_role": "mail",
      "internal_port": 1080,
      "protocol": "http",
      "health_path": "/",
      "identity_marker": "MailCatcher"
    }
  ],
  "friendly_hostname": "railsgoat.test",
  "health_check": {
    "type": "http-identity-and-functionality",
    "checks": [
      "Login identity and seeded database",
      "MySQL-specific and mail exercises remain present"
    ],
    "timeout_seconds": 120
  },
  "initialization": {
    "automatic": false,
    "steps": [
      "Run rails db:setup"
    ]
  },
  "reset": {
    "strategy": "Discard only owned database state and rerun db:setup",
    "effects": [
      "database"
    ]
  },
  "default_credentials": [
    "admin@metacorp.com / admin1234",
    "jmmastey@metacorp.com / railsgoat!"
  ],
  "resources": {
    "memory_mb": 1536,
    "cpus": 2,
    "pids": 512,
    "read_only_root": false
  },
  "ephemeral_storage": {
    "uid": 0,
    "gid": 0,
    "seeded": [],
    "empty": []
  },
  "persistence": {
    "required": true,
    "volumes": [
      "database"
    ]
  },
  "outbound_network": {
    "required": false,
    "reason": "Core application services are local; the optional supply-chain lesson loads browser assets from jsDelivr.",
    "challenge_dependencies": [
      "The supply-chain lesson requires jsDelivr unless a contained fixture is provided"
    ]
  },
  "dangerous_capabilities": [],
  "expected_functionality": [
    "Rails and OWASP Top 10 exercises",
    "Tutorial content"
  ],
  "known_limitations": [
    "Official Dockerfile is amd64-only",
    "Broad source bind mount is forbidden",
    "Some features are absent from upstream Compose"
  ],
  "last_verified": "2026-09-06",
  "adapter_status": "quarantined",
  "verification": {
    "status": "blocked",
